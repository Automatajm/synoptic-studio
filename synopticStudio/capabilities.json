{
    "dataRoles": [
        {
            "displayName": "Object ID",
            "name": "invernadero",
            "kind": "Grouping",
            "description": "Unique identifier for each object on the canvas (e.g. A01, Table-12, Seat-05)"
        },
        {
            "displayName": "Label",
            "name": "etiqueta",
            "kind": "Grouping",
            "description": "Display name shown inside each object. Defaults to Object ID if not set."
        },
        {
            "displayName": "Main Value",
            "name": "valorPrincipal",
            "kind": "Measure",
            "description": "Primary numeric measure. Drives the fill bar (0-100 = percentage). Optional — leave empty for status-only visuals."
        },
        {
            "displayName": "Text Field 1",
            "name": "campoTexto1",
            "kind": "Grouping",
            "description": "Categorical field used by color rules (e.g. Status, State, Category)"
        },
        {
            "displayName": "Tooltip Numbers",
            "name": "tooltipNumbers",
            "kind": "Measure",
            "description": "Additional numeric measures to show in the tooltip. Drag multiple measures here."
        },
        {
            "displayName": "Tooltip Text",
            "name": "tooltipText",
            "kind": "Grouping",
            "description": "Additional text fields to show in the tooltip. Drag multiple fields here."
        },
        {
            "displayName": "Layout X",
            "name": "layoutX",
            "kind": "Grouping",
            "description": "Horizontal position on canvas (0 to Canvas_W). Set column to Don't Summarize."
        },
        {
            "displayName": "Layout Y",
            "name": "layoutY",
            "kind": "Grouping",
            "description": "Vertical position on canvas (0 to Canvas_H). Set column to Don't Summarize."
        },
        {
            "displayName": "Layout W",
            "name": "layoutW",
            "kind": "Grouping",
            "description": "Object width in pixels. Set column to Don't Summarize."
        },
        {
            "displayName": "Layout H",
            "name": "layoutH",
            "kind": "Grouping",
            "description": "Object height in pixels. Set column to Don't Summarize."
        }
    ],
    "objects": {
        "reglas": {
            "displayName": "Color Rules",
            "properties": {
                "reglasJson": {
                    "displayName": "Rules (JSON)",
                    "description": "Internal: color-rule definitions. Edit via the built-in Rules editor (gear icon).",
                    "type": {
                        "text": true
                    }
                }
            }
        },
        "general": {
            "displayName": "General",
            "properties": {
                "mostrarEtiqueta": {
                    "displayName": "Show label",
                    "type": {
                        "bool": true
                    }
                },
                "mostrarValor": {
                    "displayName": "Show main value",
                    "type": {
                        "bool": true
                    }
                },
                "colorFallback": {
                    "displayName": "Default color",
                    "description": "Color used when no rule matches",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "categorical": {
                "categories": {
                    "select": [
                        { "bind": { "to": "invernadero" } },
                        { "bind": { "to": "etiqueta" } },
                        { "bind": { "to": "campoTexto1" } },
                        { "for":  { "in": "tooltipText" } },
                        { "bind": { "to": "layoutX" } },
                        { "bind": { "to": "layoutY" } },
                        { "bind": { "to": "layoutW" } },
                        { "bind": { "to": "layoutH" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                },
                "values": {
                    "select": [
                        { "bind": { "to": "valorPrincipal" } },
                        { "for":  { "in": "tooltipNumbers" } }
                    ]
                }
            }
        }
    ],
    "privileges": []
}